# Exemplo de configuração — NÃO contém segredos reais.
# Copie para .env e ajuste ao ambiente. Nenhum valor abaixo é validado para produção.

APP_ENV=development
APP_NAME=fruit-recognition-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=text

# Persistência
# Decisão pendente: o banco definitivo ainda não foi escolhido.
# Protótipo local: SQLite. Em produção, prefira PostgreSQL, por exemplo:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/frutas
DATABASE_URL=sqlite:///./fruits.db
# Conveniência de protótipo: cria as tabelas na inicialização.
# Em produção, use migrações versionadas e defina AUTO_CREATE_SCHEMA=false.
AUTO_CREATE_SCHEMA=true
DB_ECHO=false

# Upload de imagens e inferência
MAX_IMAGE_SIZE_MB=10
INFERENCE_TIMEOUT_SECONDS=10

# Política de reconhecimento (valores de exemplo, não validados em produção)
MIN_RECOGNITION_CONFIDENCE=0.85
# Enquanto a política de produto não for definida, exigir confirmação é o padrão seguro.
ALWAYS_REQUIRE_CONFIRMATION=true

# Visão computacional
# opencv = modelo ONNX real executado com cv2.dnn
# stub   = adaptador SIMULADO (não faz reconhecimento real)
# disabled = serviço indisponível (responde 503)
VISION_PROVIDER=stub
# Exceção explícita e documentada: permite o stub com APP_ENV=production apenas em ambiente isolado de testes.
ALLOW_STUB_IN_PRODUCTION=false

# Modelo (obrigatório quando VISION_PROVIDER=opencv). Baixe com scripts/fetch_model.py.
MODEL_PATH=
MODEL_LABELS_PATH=
# Identificação livre; se vazio, é derivada do nome + hash do arquivo do modelo.
MODEL_VERSION=
MODEL_INPUT_SIZE=224
# 1/255 para entrada em [0,1]; 1.0 para entrada em [0,255].
MODEL_INPUT_SCALE=0.00392156862745098
# Média por canal (B,G,R).
MODEL_INPUT_MEAN=0,0,0
MODEL_SWAP_RB=false
# auto = aplica softmax quando a saída do modelo não parece uma distribuição de probabilidades.
MODEL_OUTPUT_SOFTMAX=auto

# HTTP
# Origens separadas por vírgula. Vazio significa CORS desabilitado.
CORS_ORIGINS=http://localhost:3000
FRUITS_DEFAULT_LIMIT=20
FRUITS_MAX_LIMIT=100
